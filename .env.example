# Copy to .env. Never commit the real file.
#
# This replaced the legacy root .env.example, which carried credentials for pgAdmin and
# Redis-Commander — dev tooling that must never exist in a production topology. The password in the
# old file was published in git history before the 2026-10-15 scrub, so treat it as burned and
# rotate the dev volume (make dev-reset) rather than reusing it.

# --- Postgres --------------------------------------------------------------------------------
# Host port 6432, not 5432: this machine reserves 5432-5435 for Windows/Hyper-V (bind returns
# EACCES). Verified bindable alternatives are listed in infra/compose.dev.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only

# --- Redis -----------------------------------------------------------------------------------
# Host port 6380, not 6379: another project's container already publishes 6379 here.
# Cache values are keyed by tenant, so a Redis shared across tenants is a data-leak shape, not a
# performance choice. See MASTER_PLAN law L10.
REDIS_URL=redis://localhost:6380

# --- Connection strings used by the API ------------------------------------------------------
ConnectionStrings__Default=Host=localhost;Port=6432;Database=garments;Username=postgres;Password=change-me-local-only
ConnectionStrings__Redis=localhost:6380

# --- Frontend --------------------------------------------------------------------------------
# The web app has exactly one API client and reads its base URL from here. No hardcoded
# localhost:8080 anywhere (law L12). Dev port 3000 is taken by another project, so `next dev`
# runs on 3100.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
PORT=3100

# --- Secrets policy --------------------------------------------------------------------------
# JWT signing keys, encryption keys and any provider token are injected by the runtime
# environment. They are never defaults, never committed, and never read from appsettings.json.

# --- Access tokens ---------------------------------------------------------------------------
# Generate a fresh value; do not reuse one from anywhere else:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The application refuses to start with a missing or short key rather than inventing one, because a
# generated or copied key means anyone can mint a token for any tenant. The legacy tree committed
# its JWT secret to appsettings.json; it was scrubbed from history on 2026-10-15 and is burned.
GarmentsAuth__Issuer=garments-erp
GarmentsAuth__Audience=garments-web
GarmentsAuth__SigningKey=REPLACE_WITH_32_PLUS_CHARS_OF_REAL_ENTROPY
GarmentsAuth__LifetimeMinutes=30
