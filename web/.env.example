# Copy to .env.local. The API client reads this and nothing else: a base URL written into a
# component is how the legacy build shipped http://localhost:8080 to production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# en | bn — the buyer is a Bangladeshi factory owner, so Bangla is the default and English is the
# alternative. Setting this to en on a pilot deployment is a visible misconfiguration, not a
# preference: `Tenant.DefaultLanguage` is 'bn' server-side and the two must agree.
NEXT_PUBLIC_DEFAULT_LOCALE=bn
