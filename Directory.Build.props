<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- The gate is strict: every warning fails the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

    <!-- `recommended` is enforced on every build; `latest-all` runs as a separate non-blocking
         deep report. Enforcing all-on produces hundreds of taste findings per phase and trains
         everyone to reach for a suppression instead of a fix. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1707</WarningsNotAsErrors>

    <!-- Bangla is a first-class UI language for this product, so BCL globalisation must be real. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
